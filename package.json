{
  "name": "note-mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --minify --outfile dist/note-mcp src/index.ts",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
